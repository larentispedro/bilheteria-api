DATABASE_URL="postgresql://usuario:senha@localhost:5432/bilheteria?schema=public"
JWT_SECRET="troque-por-um-segredo-forte"
JWT_EXPIRES_IN="8h"
PORT=3000
RESERVA_EXPIRACAO_MINUTOS=10

# Produção: com NODE_ENV=production (ou SEED_APENAS_OPERADOR=true), "npm run
# seed" cria só o usuário operador padrão, sem filme/sala/sessão de demonstração.
NODE_ENV=
SEED_APENAS_OPERADOR=
